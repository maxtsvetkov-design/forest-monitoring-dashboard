# Copy this file to .env.local (gitignored) and fill in your own values.
# Restart the dev server after changing it.
#
# The Maps tab needs no key: it uses free OpenStreetMap tiles (MapLibre GL)
# for the base map and AWS's public Terrarium elevation tiles for 3D terrain.

# Anthropic API key, used by the AI assistant panel. Get one at
# https://console.anthropic.com/settings/keys
# WARNING: this ships into the browser bundle in this front-end-only project.
# Fine for a local/private demo; do not deploy this build publicly as-is.
VITE_ANTHROPIC_API_KEY=
